  m_Script: {fileID: 11500000, guid: 3dd24cc548d23ba6aa1975c4f1100615, type: 3}
  m_Name: 03-TypesOfForces
  m_EditorClassIdentifier: 
  lessonId: forceTypeContact
  lessonTitle: Types of Forces
  lessonImage: {fileID: 0}
  lessonDesc: "Contact Forces\nThese forces that require direct physical contact
    between objects.\n      Friction - the force that opposes the motion between
    two surfaces in contact.\n      Tension - the force transmitted through a string,
    rope, or cable when it is pulled tight.\n      Normal Force - the force exerted
    perpendicular to the surface when one object pushes against another.\n      Muscular
    Force - the force that allows us to move our body parts and interact with the
    external environment."
