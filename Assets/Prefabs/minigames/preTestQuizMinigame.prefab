  m_Script: {fileID: 11500000, guid: c911ebf07650941888581c84899f6317, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - description: 'A force is defined as a:'
    trueAnswer: Push and pull that can cause an object to change
    answers:
    - Push and pull that can cause an object to change
    - Measurement of an object's mass
    - Invisible field that surrounds all objects
    - None of the above
  - description: Which of the following is NOT an effect a force can have on an object?
    trueAnswer: Increase its temperature
    answers:
    - Change its speed
    - Change its direction
    - Change its shape
    - Increase its temperature
  - description: Which of these is an example of a contact force?
    trueAnswer: Friction
    answers:
    - Gravity
    - Friction
    - Electromagnetism
    - Both Friction & Electromagnetism
  - description: 'A non-contact force is a force that:'
    trueAnswer: Can act on objects without them touching
    answers:
    - Requires direct physical contact between objects
    - Can act on objects without them touching
    - Only exists in a vacuum
    - None of the above
  - description: 'The direction of a force refers to:'
    trueAnswer: The way the force is pushing or pulling
    answers:
    - How strong the force is
    - The path the object will take
    - The way the force is pushing or pulling
    - The objects involved in the force
  - description: 'The magnitude of a force is a measue of its:'
    trueAnswer: Strength
    answers:
    - Direction
    - Strength
    - Duration
    - Both Strength & Duration
  - description: 'The properties of the objects involved in a force, such as their
      mass and surface area, can affect:'
    trueAnswer: All of the above
    answers:
    - The direction of the force
    - The magnitude of the force
    - Whether the force is contact or non-contact
    - All of the above
  - description: Which of the following would be considered a non-contact force?
    trueAnswer: Gravitational force
    answers:
    - Tension
    - Normal force
    - Gravitational force
    - Friction
  - description: 'If an object''s speed increases due to a force, the force must
      be:'
    trueAnswer: Pushing in the direction of motion
    answers:
    - Pushing in the direction of motion
    - Pulling in the direction of motion
    - Perpendicular to the direction of motion
    - Both pushing & pulling in the direction of motion
  - description: 'Understanding the characteristics of a force is important because
      it helps explain:'
    trueAnswer: All of the above
    answers:
    - How force will affect an object's motion
    - What type of force it is
    - The objects involved in the force
    - All of the above
